# Copy this file to .env and fill in the values you need.
# You only need the lines for the features you actually use — leave the rest blank.

# --- Uploading scraped data to Supabase (only if you use `--upload`) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Seeding the accountability tracker (`suu seed election`) ---
# A service-role key, not the anon key above — these writes need to bypass RLS.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: where suu keeps your saved logins (defaults to ~/.suu) ---
# SUU_HOME=
